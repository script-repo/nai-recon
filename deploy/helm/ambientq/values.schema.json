{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ambientq Helm values",
  "type": "object",
  "required": [
    "image",
    "nai",
    "harness",
    "auth",
    "persistence",
    "service"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9./:_-]+$"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "nai": {
      "type": "object",
      "required": [
        "baseUrl",
        "model",
        "apiKeySecret"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "verifierModel": {
          "type": "string"
        },
        "replayModel": {
          "type": "string"
        },
        "apiKeySecret": {
          "type": "string",
          "minLength": 1
        },
        "apiKeySecretKey": {
          "type": "string",
          "minLength": 1
        },
        "caConfigMap": {
          "type": "string"
        }
      }
    },
    "harness": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "subPath": {
          "type": "string"
        },
        "gitSecret": {
          "type": "string"
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "harness": {
            "type": "string"
          },
          "team": {
            "type": "string"
          }
        }
      }
    },
    "teams": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "sampling": {
          "type": "object",
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "replay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mode": {
              "enum": [
                "multi",
                "single"
              ]
            },
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "unmatched": {
              "enum": [
                "nearest",
                "error",
                "stop"
              ]
            }
          }
        }
      }
    },
    "shadow": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]+[smhdw]$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "default": {
          "$ref": "#/definitions/price"
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/price"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "oidc",
            "proxy"
          ]
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(https?://.*)?$"
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "cookieInsecure": {
          "type": "boolean"
        },
        "sessionSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https://.*)?$"
            },
            "clientId": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            },
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "userHeader": {
              "type": "string"
            },
            "emailHeader": {
              "type": "string"
            },
            "groupsHeader": {
              "type": "string"
            },
            "trustedProxies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "admin": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string"
                      },
                      "user": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "teams": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "approver": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string"
                      },
                      "user": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "teams": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "viewer": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string"
                      },
                      "user": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "teams": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "minSeverity": {
          "$ref": "#/definitions/severity"
        },
        "onRegression": {
          "type": "boolean"
        },
        "webhooks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "secretName"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "slack",
                  "teams",
                  "generic"
                ]
              },
              "minSeverity": {
                "$ref": "#/definitions/severity"
              },
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "forge": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "",
            "github",
            "gitlab",
            "gitea"
          ]
        },
        "apiUrl": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ingestTokenSecret": {
      "type": "string"
    },
    "schedule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cron": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "postgresUrlSecret": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "pathType": {
          "enum": [
            "Prefix",
            "Exact",
            "ImplementationSpecific"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tlsSecret": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "egressCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "liveness": {
          "type": "object"
        },
        "readiness": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    }
  },
  "definitions": {
    "price": {
      "type": "object",
      "properties": {
        "input_per_1k": {
          "type": "number",
          "minimum": 0
        },
        "output_per_1k": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
